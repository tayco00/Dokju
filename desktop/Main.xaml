<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokju" Width="1180" Height="800" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="#1A2739" Background="#F3F5F8" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#23374C"/>
      <Setter Property="BorderBrush" Value="#C6D2DD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.67"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C98723"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="#08665D"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#08665D"/>
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="#1E3044"/>
      <Setter Property="Foreground" Value="#EBF1F7"/>
      <Setter Property="BorderBrush" Value="#35465B"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#DBE2EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="#C6D2DD"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1A2739"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1A2739"/>
      <Setter Property="BorderBrush" Value="#C6D2DD"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
              <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="10,0,29,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
              <Path Data="M0,0 L4,4 L8,0" Stroke="#53667A" StrokeThickness="1.4" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Background="#FFFFFF" BorderBrush="#C6D2DD" BorderThickness="1" CornerRadius="8" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="260" SnapsToDevicePixels="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="#F7FAFC"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#A85C13"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ListRow" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemSurface" Background="#FFFFFF" BorderBrush="#E0E7EF" BorderThickness="1"
                    CornerRadius="8" Padding="11,10"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#F1F6FA"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#E8F4F2"/>
                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#80B7AD"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#B96B24"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#152337">
      <DockPanel x:Name="SidebarPanel" LastChildFill="False" Margin="16,25,16,18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="3,0,0,32">
          <Image x:Name="BrandLogo" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Dokju" FontSize="27" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="10,0,0,1"/>
        </StackPanel>
        <Button x:Name="ConnectionButton" DockPanel.Dock="Top" Style="{StaticResource SidebarButton}" Content="Verbindung"/>
        <Button x:Name="VerifyButton" DockPanel.Dock="Top" Style="{StaticResource SidebarButton}" Content="Nachweis prüfen"/>
        <Button x:Name="UpdateButton" DockPanel.Dock="Top" Style="{StaticResource SidebarButton}" Content="Updates"/>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="ConnectionText" Text="Startet …" Foreground="#C1D0DF" TextWrapping="Wrap" FontSize="12" Margin="2,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid x:Name="WorkArea" Grid.Column="1" Margin="27,24,27,15">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="NewButton" Style="{StaticResource Primary}" Content="+  Neuer Vorgang" ToolTip="Neuer Vorgang (Strg+N)"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Einwilligungen" FontSize="36" FontWeight="SemiBold"/>
          <TextBlock x:Name="HeaderSubtitle" Text="Gespräche mit KI-Protokollierung" Foreground="#53667A" FontSize="14" Margin="1,2,0,0"/>
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,8,0">
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="CaseCount" Text="0" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Right"/>
            <TextBlock Text="Vorgänge" Foreground="#53667A"/>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,8,0">
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="OpenCount" Text="0" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Right"/>
            <TextBlock Text="Offene Einladungen" Foreground="#53667A"/>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,8">
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="ReadyCount" Text="0" FontSize="24" Foreground="#08665D" FontWeight="SemiBold" DockPanel.Dock="Right"/>
            <TextBlock Text="Freigegeben" Foreground="#53667A"/>
          </DockPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="CasesColumn" Width="242"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Vorgänge" FontSize="19" FontWeight="SemiBold" Margin="1,0,0,11"/>
            <Grid Grid.Row="1" Margin="0,0,0,9">
              <TextBox x:Name="SearchBox" ToolTip="Nach Gespräch oder Aktenzeichen filtern" AutomationProperties.Name="Vorgänge suchen"/>
              <TextBlock Text="Gespräch oder Aktenzeichen" Foreground="#53667A" FontSize="12" Margin="11,0,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <ComboBox x:Name="CaseFilter" Grid.Row="2" SelectedIndex="0" MinHeight="33" Margin="0,0,0,11" AutomationProperties.Name="Nach Status filtern">
              <ComboBoxItem Content="Alle Status"/><ComboBoxItem Content="Offen"/><ComboBoxItem Content="Freigegeben"/><ComboBoxItem Content="Blockiert"/>
            </ComboBox>
            <ListBox x:Name="CaseList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding title}">
                    <TextBlock Text="{Binding title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding reference}" FontSize="12" Foreground="#53667A" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#08665D" Margin="0,4,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyList" Grid.Row="3" Text="Keine Vorgänge" Foreground="#53667A" VerticalAlignment="Top" Margin="3,6,0,0" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <Grid>
            <StackPanel x:Name="EmptyDetail" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
              <Border Background="#E4F3EE" Width="58" Height="58" CornerRadius="15" Margin="0,0,0,12">
                <Path Data="M 1,8 L 8,15 L 22,1" Stroke="#08665D" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="EmptyTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptyHint" MaxWidth="310" TextWrapping="Wrap" TextAlignment="Center" Foreground="#53667A" Margin="0,5,0,0"/>
              <Button x:Name="FirstCaseButton" Content="Vorgang anlegen" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,17,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="Detail" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="DetailPane" Margin="23,19,22,20">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="7,0,0,0">
                    <Button x:Name="ExportButton" Content="Nachweis exportieren" AutomationProperties.Name="Nachweis exportieren"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailReference" Foreground="#53667A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  </StackPanel>
                </DockPanel>
                <Border x:Name="DecisionBand" Background="#EFF5EF" CornerRadius="9" Padding="12,8" Margin="0,16,0,15">
                  <StackPanel>
                    <TextBlock x:Name="DecisionState" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DecisionText" FontSize="13" TextWrapping="Wrap" Margin="0,1,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="Teilnehmende" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="PersonList" MinHeight="34" AutomationProperties.Name="Teilnehmende Person auswählen">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <DockPanel Margin="0,5,0,0">
                  <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                    <Button x:Name="RenewButton" Content="Einladung erneuern" AutomationProperties.Name="Einladung erneuern" Visibility="Collapsed"/>
                    <Button x:Name="WithdrawButton" Content="Widerruf erfassen" Visibility="Collapsed"/>
                    <Button x:Name="WithdrawalLinkButton" Content="Widerrufslink kopieren" Visibility="Collapsed" Margin="0,5,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="PersonTime" Foreground="#53667A" FontSize="12" TextWrapping="Wrap"/>
                </DockPanel>
                <Border x:Name="QrCard" Background="#EDF4F6" CornerRadius="12" BorderBrush="#D7E5E9" BorderThickness="1" Padding="13" Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="QrColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image x:Name="QrImage" Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           AutomationProperties.Name="QR-Code zur Einwilligung"/>
                    <StackPanel x:Name="QrDetails" Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Einwilligung öffnen" FontWeight="SemiBold" FontSize="18"/>
                      <TextBlock x:Name="QrHint" Foreground="#53667A" TextWrapping="Wrap" Margin="0,4,0,9"/>
                      <WrapPanel>
                        <Button x:Name="OpenButton" Style="{StaticResource Primary}" Content="Im Browser öffnen" Margin="0,0,7,4"/>
                        <Button x:Name="CopyButton" Content="Link kopieren" Margin="0,0,0,4"/>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
                <WrapPanel Margin="0,9,0,0">
                  <Button x:Name="EditButton" Content="Vorgang bearbeiten" Margin="0,0,7,4"/>
                  <Button x:Name="MobileButton" Content="Mobilzugang einrichten" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock x:Name="RetentionText" Foreground="#53667A" TextWrapping="Wrap" FontSize="12" Margin="0,11,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="3" Text="Dokju startet …" Foreground="#53667A" TextWrapping="Wrap" Margin="1,9,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </Grid>
</Window>
